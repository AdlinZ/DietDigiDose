# DNS A/AAAA 记录必须先指向 staging 主机。
STAGING_DOMAIN=staging-api.example.com
ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# 迁移账号 URL；正式环境应与应用账号分离并由密钥管理器注入。
DATABASE_MIGRATION_URL=postgresql://dietdigidose:replace-with-url-encoded-password@postgres:5432/dietdigidose
