# 服务端监听配置。
PORT=9091
NODE_ENV=development

# 生产环境必填，至少 32 个字符。
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# 仅首次创建管理员时使用，至少 12 位；首次登录后仍会强制修改。
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-bootstrap-password

# 可选：模型服务配置也可以在管理端保存。
AI_API_KEY=
# 也可以使用 OPENAI_API_KEY 作为 AI_API_KEY 的兼容别名。
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# 可选：USDA FoodData Central。未配置时使用限流更严格的 DEMO_KEY。
USDA_API_KEY=

# 可选：Supabase。只有启用 Supabase 数据访问时才需要配置。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
