# Development default for Expo Web. For a physical device, use your computer's
# LAN IP instead (for example http://192.168.1.100:9090).
# preview/production builds read the deployed HTTPS API from the matching EAS
# environment. The preview-http profile is only for controlled HTTP packaging
# tests with disposable accounts and must not be distributed as a Beta candidate.
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9090
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=0
EXPO_PUBLIC_DEPLOYMENT_PROFILE=china
EXPO_PUBLIC_APP_NAME=食光烙记
EXPO_PUBLIC_APP_SLUG=dietdigidose
EXPO_PUBLIC_ANDROID_PACKAGE=com.dietdigidose.app
