{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-http": {
      "extends": "preview",
      "channel": "preview-http",
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "http://118.145.165.226:8088",
        "EXPO_PUBLIC_ALLOW_INSECURE_HTTP": "1"
      }
    },
    "simulator": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "http://127.0.0.1:9090",
        "EXPO_PUBLIC_ALLOW_INSECURE_HTTP": "1"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  }
}
