{
  "name": "dietdigidose",
  "private": true,
  "version": "1.0.5",
  "scripts": {
    "dev:client": "pnpm --dir ./client start",
    "dev:server": "pnpm --dir ./server dev",
    "dev:admin": "pnpm --dir ./admin dev",
    "dev:app": "pnpm dlx concurrently --names client,server --prefix-colors cyan,green \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:all": "pnpm dlx concurrently --names app,admin --prefix-colors cyan,magenta \"pnpm dev:app\" \"pnpm dev:admin\"",
    "dev": "pnpm dev:app",
    "build:client": "pnpm --dir ./client build",
    "build:server": "pnpm --dir ./server build",
    "staging:smoke": "node deploy/staging-smoke.mjs",
    "build:admin": "pnpm --dir ./admin build",
    "validate:toolchain": "node scripts/validate-toolchain.mjs",
    "validate:release": "node scripts/validate-release-metadata.mjs",
    "preinstall": "npx only-allow pnpm",
    "lint:client": "pnpm --dir ./client lint",
    "lint:server": "pnpm --dir ./server lint",
    "lint:admin": "pnpm --dir ./admin lint",
    "lint:all": "pnpm lint:client && pnpm lint:server && pnpm lint:admin",
    "test:client": "pnpm --dir ./client test",
    "test:server": "pnpm --dir ./server test",
    "test:admin": "pnpm --dir ./admin test",
    "test:unit": "pnpm --dir ./client test && pnpm --dir ./server test:unit && pnpm --dir ./admin test",
    "test:contract": "pnpm --dir ./server test:contract",
    "test:e2e": "pnpm --dir ./server test:e2e",
    "test:migrations": "pnpm --dir ./server db:rehearse -- --owner=quality-gate",
    "test:coverage": "pnpm --dir ./client test:coverage && pnpm --dir ./server test:coverage",
    "test:stability": "node scripts/run-test-stability.mjs",
    "contracts:generate": "pnpm --dir ./packages/contracts openapi:generate",
    "contracts:check": "pnpm --dir ./packages/contracts check",
    "architecture:check": "node scripts/check-module-boundaries.mjs",
    "provider:smoke": "node scripts/smoke-provider-profiles.mjs",
    "database:schema:generate": "node scripts/generate-postgres-baseline.mjs",
    "database:schema:check": "node scripts/generate-postgres-baseline.mjs --check && pnpm --dir ./server db:postgres:check",
    "database:boundary:update": "node scripts/check-sqlite-boundary.mjs --update",
    "database:boundary:check": "node scripts/check-sqlite-boundary.mjs",
    "test:all": "pnpm test:client && pnpm test:server && pnpm test:admin",
    "quality:test-quarantine": "node scripts/check-test-quarantine.mjs",
    "quality:build-budgets": "node scripts/check-build-budgets.mjs",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org"
  },
  "dependencies": {},
  "devDependencies": {},
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.18.0"
  }
}
