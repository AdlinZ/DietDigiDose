{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "worker:run": "tsx src/worker.ts --once",
    "import:open-food-facts": "tsx scripts/import-open-food-facts.ts",
    "import:howtocook": "tsx scripts/import-howtocook.ts",
    "import:wikibooks-recipes": "tsx scripts/import-wikibooks-recipes.ts",
    "import:taiwan-fda": "tsx scripts/import-taiwan-fda.ts",
    "import:rollback": "tsx scripts/rollback-content-import.ts",
    "backfill:ingredient-groups": "tsx scripts/backfill-ingredient-groups.ts",
    "localize:ingredient-names": "tsx scripts/localize-ingredient-names.ts",
    "db:backup": "tsx scripts/database-backup.ts backup",
    "db:restore": "tsx scripts/database-backup.ts restore",
    "db:inspect": "tsx scripts/database-backup.ts inspect",
    "db:rehearse": "pnpm build && tsx scripts/database-rehearsal.ts",
    "db:postgres:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:postgres:check": "drizzle-kit check --config drizzle.config.ts",
    "db:postgres:migrate": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "media:migrate": "tsx scripts/migrate-community-media.ts",
    "preinstall": "npx only-allow pnpm",
    "start": "node scripts/start-production.mjs",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test test/accessControlModule.test.ts test/authAccountModule.test.ts test/householdsModule.test.ts test/adminCommunityModule.test.ts test/adminUsersModule.test.ts test/adminConsoleModule.test.ts test/adminFoodAssetsModule.test.ts test/adminKitchenwareModule.test.ts test/adminRecipesModule.test.ts test/agentArchitecture.test.ts test/aiErrors.test.ts test/communityModule.test.ts test/communityRecommendation.test.ts test/contentGovernance.test.ts test/cookingQueueModule.test.ts test/databaseBackup.test.ts test/dietRecordsModule.test.ts test/feedbackModule.test.ts test/foodModule.test.ts test/healthModule.test.ts test/insightsModule.test.ts test/inventoryModule.test.ts test/kitchenwareModule.test.ts test/mealPlansModule.test.ts test/mediaStorage.test.ts test/postgresMigration.test.ts test/providerProfiles.test.ts test/recipeQuality.test.ts test/recipesModule.test.ts test/recommendationsModule.test.ts test/scriptsCompatibility.test.ts test/shoppingModule.test.ts test/voicePacksModule.test.ts test/workerModule.test.ts",
    "test:contract": "tsx --test --test-concurrency=1 test/app.test.ts",
    "test:postgres-migration": "tsx test/postgresMigration.integration.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/milestone35.test.ts",
    "test:coverage": "tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=70 test/**/*.test.ts",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "2.0.0",
    "@alicloud/openapi-core": "1.0.8",
    "@darabonba/typescript": "1.0.5",
    "@dietdigidose/contracts": "workspace:*",
    "@ip-location-db/geolite2-country-mmdb": "2.3.2026061719",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^1.5.6",
    "@supabase/supabase-js": "2.95.3",
    "@types/better-sqlite3": "^7.6.13",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.5",
    "maxmind": "5.0.7",
    "multer": "^2.2.0",
    "opencc-js": "^1.4.1",
    "pg": "^8.16.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "esbuild": "0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
